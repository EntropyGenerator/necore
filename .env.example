# Serve port
PORT=3000
# JWT secret
SECRET="replace-with-at-least-32-random-bytes"

# Bot connections
BOT_LOG_BUFFER_SIZE=1000
BOT_HEARTBEAT_TIMEOUT_SECONDS=90

# Rate limiting (per IP, applied to API routes; /contents and /slogan are exempt)
RATE_LIMIT_MAX=600
RATE_LIMIT_EXPIRATION=60

# Skin stations (Blessing Skin Yggdrasil) for player skin resolution, comma separated
SKIN_STATIONS=https://skin.nmo.net.cn,https://skin.mualliance.ltd
